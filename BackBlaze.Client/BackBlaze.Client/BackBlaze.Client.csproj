<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackageId>Lipa.BackBlaze.ClientV2</PackageId>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Version>9.0.1</Version>
		<Authors>Lipa</Authors>
		<Company>Lipa</Company>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/Aniluffi/Back-Blaze_Nuget.git</RepositoryUrl>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Description>
			9.0.1 - создан нугет для работы с BackBlaze B2
		</Description>
	</PropertyGroup>

	<ItemGroup>
		<!-- Подключаем README.md из корня репозитория -->
		<None Include="..\..\README.md" Pack="true" PackagePath="" Link="README.md" />
	</ItemGroup>

	<PropertyGroup>
		<!-- Чтобы NuGet включал зависимости автоматически -->
		<IncludeSymbols>true</IncludeSymbols>
		<IncludeSource>true</IncludeSource>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.17" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.17" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="9.0.17" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.17" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Http.Client\Http.Client.csproj" />
	</ItemGroup>

</Project>
